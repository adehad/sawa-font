---
import Base from "../../layouts/Base.astro";
import ControlDock from "../../components/controls/ControlDock.astro";
import SampleControls from "../../components/compare/SampleControls.astro";
import TypeControls from "../../components/compare/TypeControls.astro";
import FontRoster from "../../components/compare/FontRoster.astro";
import LocalFont from "../../components/compare/LocalFont.astro";
import Stage from "../../components/compare/Stage.astro";
import FeaturePanel from "../../components/compare/FeaturePanel.astro";
import PaletteControl from "../../components/compare/PaletteControl.astro";
import { CLIENT_KEYS, messagesJson, type ClientMessages } from "../../components/compare/messages";
import { rawMessage, t } from "../../i18n/t";
import { LOCALES, type Locale } from "../../i18n/locales";
import { loadFontsData } from "../../fonts/load";
import { paletteCss } from "../../fonts/specimen";
import { isReportOnly } from "../../report/mode";

export function getStaticPaths() {
  if (isReportOnly()) {
    return [];
  }
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang as Locale;
const clientMessages = Object.fromEntries(
  CLIENT_KEYS.map((key) => [key, rawMessage(locale, key)]),
) as ClientMessages;
const pageCss = paletteCss(loadFontsData());
---

<Base locale={locale} page="compare" title={t(locale, "compare.title")} wide>
  <style is:global set:html={pageCss}></style>
  <script type="application/json" data-compare-messages set:html={messagesJson(clientMessages)}
  ></script>
  <div class="compare dock-layout">
    <ControlDock
      locale={locale}
      heading={t(locale, "compare.controlsHeading")}
      openLabel={t(locale, "compare.controlsOpen")}
    >
      <div
        class="control-groups"
        data-compare-controls
        data-size-template={rawMessage(locale, "controls.summarySize")}
      >
        <SampleControls locale={locale} />
        <TypeControls locale={locale} />
        <FontRoster locale={locale} />
        <PaletteControl locale={locale} />
        <FeaturePanel locale={locale} />
        <LocalFont locale={locale} />
      </div>
    </ControlDock>
    <div class="compare-main">
      <header class="compare-intro">
        <h1>{t(locale, "compare.h1")}</h1>
        <p>{t(locale, "compare.body")}</p>
      </header>
      <Stage locale={locale} />
    </div>
  </div>
</Base>

<script>
  import { COMPARE_WEIGHT } from "../../fonts/compare";
  import { storedWeight } from "../../fonts/specimen";
  import { setDockSummary } from "../../components/controls/dock";
  import { fillTemplate } from "../../components/controls/summary";
  import { commit, readState, subscribe } from "../../state/store";
  import { clampSize } from "../../state/url";

  const loaded = readState();
  const weight = storedWeight(loaded.weight, COMPARE_WEIGHT);
  if (weight !== loaded.weight) {
    commit({ ...loaded, weight });
  }

  const controls = document.querySelector<HTMLElement>("[data-compare-controls]");
  if (controls) {
    const numbers = new Intl.NumberFormat(document.documentElement.lang);
    const sizeTemplate = controls.dataset.sizeTemplate ?? "{size}";
    const label = (selector: string): string =>
      controls.querySelector(selector)?.textContent?.trim() ?? "";
    subscribe((state) => {
      setDockSummary([
          label(`[data-preset] option[value="${state.preset}"]`),
          fillTemplate(sizeTemplate, { size: numbers.format(clampSize(state.size)) }),
          label(`[data-view-button="${state.view}"]`),
      ]);
    });
  }
</script>

<style is:global>
  .compare-main {
    display: grid;
    align-content: start;
    gap: 1.5rem;
    min-inline-size: 0;
  }

  .compare-intro h1 {
    margin-block: 0 0.5rem;
  }

  .compare-intro p {
    margin: 0;
    max-inline-size: 46rem;
    color: var(--color-muted);
  }

  .compare .control-groups {
    display: grid;
    align-content: start;
    gap: 1.25rem;
    min-inline-size: 0;
  }

  .compare .control {
    display: grid;
    align-content: start;
    gap: 0.5rem;
    min-inline-size: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .compare .control[hidden] {
    display: none;
  }

  .compare .control legend,
  .compare .control > label,
  .compare .control-head label,
  .compare .control-title {
    padding: 0;
    margin: 0;
    font-family: var(--font-ui);
    font-size: 1rem;
    font-weight: 600;
  }

  .compare .control legend {
    margin-block-end: 0.5rem;
  }

  .compare .control-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }

  .compare .control-head output {
    font-variant-numeric: tabular-nums;
    font-size: 0.9rem;
  }

  .compare .control-note {
    margin: 0;
    font-size: 0.85rem;
    color: var(--color-muted);
  }

  .compare .control-note:empty {
    display: none;
  }

  .compare input[type="range"] {
    inline-size: 100%;
    min-block-size: 44px;
    margin: 0;
    accent-color: var(--color-accent);
  }

  .compare select,
  .compare textarea {
    inline-size: 100%;
    border: 1px solid var(--color-rule);
    border-radius: 0.4rem;
    background: var(--color-bg);
    color: var(--color-ink);
    font: inherit;
  }

  .compare .control > select {
    min-block-size: 44px;
    padding-inline: 0.5rem;
  }

  .compare textarea {
    padding: 0.6rem 0.75rem;
    font-size: 1rem;
    line-height: 1.6;
    resize: vertical;
  }

  .compare .check {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    min-block-size: 44px;
  }

  .compare .check input {
    flex: none;
    inline-size: 1.3rem;
    block-size: 1.3rem;
    margin: 0;
    accent-color: var(--color-accent);
  }

  .compare .check label {
    cursor: pointer;
  }
</style>
