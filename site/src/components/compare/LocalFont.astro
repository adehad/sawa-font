---
import { t } from "../../i18n/t";
import type { Locale } from "../../i18n/locales";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<div class="control local-font" data-local-font>
  <label for="compare-local-file">{t(locale, "compare.localName")}</label>
  <input
    id="compare-local-file"
    type="file"
    accept=".ttf,.otf,.woff,.woff2"
    aria-describedby="compare-local-privacy"
    data-local-file
  />
  <p id="compare-local-privacy" class="control-note">{t(locale, "compare.localPrivacy")}</p>
  <p class="control-note" role="status" data-local-status></p>
</div>

<script>
  import { clientFormat } from "./messages";
  import { loadLocalFont } from "./local-font";
  import { commit, readState } from "../../state/store";
  import { toggleFont } from "../../state/url";

  const root = document.querySelector<HTMLElement>("[data-local-font]");
  const input = root?.querySelector<HTMLInputElement>("[data-local-file]");
  const status = root?.querySelector<HTMLElement>("[data-local-status]");
  if (input && status) {
    const format = clientFormat();
    input.addEventListener("change", async () => {
      const file = input.files?.[0];
      if (!file) {
        return;
      }
      try {
        const loaded = await loadLocalFont(file);
        if (!loaded) {
          return;
        }
        status.textContent = format("compare.localLoaded", { name: `⁨${file.name}⁩` });
        const state = readState();
        if (!state.fonts.includes("local")) {
          commit(toggleFont(state, "local"));
        }
      } catch {
        status.textContent = format("compare.localError");
      }
    });
  }
</script>

<style>
  input[type="file"] {
    max-inline-size: 100%;
    min-block-size: 44px;
    font: inherit;
  }

  input[type="file"]::file-selector-button {
    min-block-size: 44px;
    margin-inline-end: 0.75rem;
    padding-inline: 0.9rem;
    border: 1px solid var(--color-rule);
    border-radius: 0.4rem;
    background: var(--color-surface);
    color: var(--color-ink);
    font: inherit;
    cursor: pointer;
  }
</style>
