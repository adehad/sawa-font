---
import { t } from "../../i18n/t";
import type { Locale } from "../../i18n/locales";
import { SECTION_CONTROLS, type SectionId } from "./sections";

interface Props {
  locale: Locale;
  section: SectionId;
}

const { locale, section } = Astro.props;
const labelId = `controlled-by-${section}`;
---

<div class="controlled-by" role="group" aria-labelledby={labelId}>
  <span id={labelId} class="controlled-by-label">{t(locale, "controls.controlledBy")}</span>
  {
    SECTION_CONTROLS[section].map((control) => (
      <button type="button" class="controlled-by-chip" data-reveal-control={control}>
        {t(locale, `controls.name.${control}`)}
      </button>
    ))
  }
</div>

<script>
  import { revealControl } from "../controls/dock";

  document.querySelectorAll<HTMLButtonElement>("[data-reveal-control]").forEach((chip) => {
    chip.addEventListener("click", () => {
      if (chip.dataset.revealControl) {
        revealControl(chip.dataset.revealControl, chip);
      }
    });
  });
</script>

<style>
  .controlled-by {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    margin-block: 0 1rem;
    font-size: 0.9rem;
  }

  .controlled-by-label {
    margin-inline-end: 0.2rem;
    color: var(--color-muted);
  }

  .controlled-by-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-block-size: 44px;
    padding-inline: 0.75rem;
    border: 1px dashed var(--color-accent);
    border-radius: 999px;
    background: transparent;
    color: var(--color-accent);
    font: inherit;
    cursor: pointer;
  }

  .controlled-by-chip:hover {
    border-style: solid;
  }

  .controlled-by-chip[hidden] {
    display: none;
  }
</style>
