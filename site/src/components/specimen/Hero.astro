---
import { t } from "../../i18n/t";
import type { Locale } from "../../i18n/locales";
import { defaultState } from "../../state/url";
import { specimenSample } from "../../samples";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const initial = defaultState();
const initialSample = specimenSample(initial.preset, initial.text);
---

<section class="hero" aria-labelledby="hero-title" data-hero>
  <h1 id="hero-title" class="hero-wordmark in-family" dir="auto">
    {t(locale, "specimen.wordmark")}
  </h1>
  <p class="hero-lede">{t(locale, "specimen.lede")}</p>
  <p class="hero-specimen in-family" dir="auto" data-specimen>{initialSample}</p>
</section>

<script>
  import { specimenSample } from "../../samples";
  import { subscribe } from "../../state/store";

  const specimen = document.querySelector<HTMLElement>("[data-hero] [data-specimen]");
  if (specimen) {
    subscribe((state) => {
      specimen.textContent = specimenSample(state.preset, state.text);
    });
  }
</script>

<style>
  .hero {
    display: grid;
    gap: 1.5rem;
    padding-block-end: 2.5rem;
    border-block-end: 1px solid var(--color-rule);
  }

  .hero-wordmark {
    margin: 0;
    font-size: clamp(3.5rem, 10vw, 8rem);
    line-height: 1.1;
    font-weight: var(--wght, var(--wght-default));
  }

  .hero-lede {
    margin: 0;
    max-inline-size: 44rem;
    font-size: 1.15rem;
    color: var(--color-muted);
  }

  .hero-specimen {
    margin: 0;
    min-block-size: 2em;
    font-size: var(--specimen-size, 32px);
    white-space: pre-line;
    overflow-wrap: anywhere;
  }
</style>
