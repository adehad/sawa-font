---
import { t } from "../../i18n/t";
import type { Locale } from "../../i18n/locales";

interface Props {
  locale: Locale;
  /** Names the panel; the aside and the sheet take their accessible name from it. */
  heading: string;
  /** The floating button's accessible name; it starts with the visible "Settings" label. */
  openLabel: string;
}

const { locale, heading, openLabel } = Astro.props;
const headingId = "dock-heading";
const panelId = "dock-panel";
---

<aside class="dock" aria-labelledby={headingId} data-dock data-open="false">
  <button
    type="button"
    class="dock-toggle"
    aria-expanded="false"
    aria-controls={panelId}
    data-dock-toggle
  >
    <svg
      class="dock-icon"
      aria-hidden="true"
      viewBox="0 0 24 24"
      width="22"
      height="22"
      fill="none"
      stroke="currentColor"
      stroke-width="1.75"
      stroke-linecap="round"
    >
      <path d="M4 7h10M18 7h2M4 17h4M12 17h8"></path>
      <circle cx="16" cy="7" r="2"></circle>
      <circle cx="10" cy="17" r="2"></circle>
    </svg>
    <span class="dock-toggle-label">{t(locale, "controls.settings")}</span>
    <span class="dock-summary" data-dock-summary></span>
    <svg
      class="dock-chevron"
      aria-hidden="true"
      viewBox="0 0 24 24"
      width="18"
      height="18"
      fill="none"
      stroke="currentColor"
      stroke-width="1.75"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M6 9l6 6 6-6"></path>
    </svg>
  </button>
  <div class="dock-home" data-dock-home>
    <div class="dock-panel" id={panelId} data-dock-panel>
      <h2 id={headingId} class="dock-heading">{heading}</h2>
      <slot />
    </div>
  </div>
</aside>

<button
  type="button"
  class="dock-fab"
  aria-haspopup="dialog"
  aria-label={openLabel}
  aria-describedby="dock-fab-summary"
  data-dock-fab
>
  <svg
      class="dock-icon"
      aria-hidden="true"
      viewBox="0 0 24 24"
      width="22"
      height="22"
      fill="none"
      stroke="currentColor"
      stroke-width="1.75"
      stroke-linecap="round"
    >
      <path d="M4 7h10M18 7h2M4 17h4M12 17h8"></path>
      <circle cx="16" cy="7" r="2"></circle>
      <circle cx="10" cy="17" r="2"></circle>
    </svg>
  <span class="dock-fab-text">
    <span class="dock-fab-label">{t(locale, "controls.settings")}</span>
    <span id="dock-fab-summary" class="dock-fab-summary" data-dock-summary></span>
  </span>
</button>

<dialog class="dock-sheet" aria-labelledby={headingId} data-dock-sheet>
  <div class="dock-sheet-bar">
    <button
      type="button"
      class="dock-sheet-close"
      aria-label={t(locale, "controls.close")}
      data-dock-close
    >
      <svg
        aria-hidden="true"
        viewBox="0 0 24 24"
        width="22"
        height="22"
        fill="none"
        stroke="currentColor"
        stroke-width="1.75"
        stroke-linecap="round"
      >
        <path d="M6 6l12 12M18 6L6 18"></path>
      </svg>
    </button>
  </div>
  <div class="dock-sheet-body" data-dock-sheet-slot></div>
</dialog>

<script>
  import { initDock } from "./dock";

  initDock();
</script>

<style is:global>
  .dock-layout {
    display: grid;
    gap: 1.5rem;
  }

  .dock {
    min-inline-size: 0;
  }

  .dock-toggle,
  .dock-fab {
    display: none;
  }

  .dock-panel {
    padding: 1.25rem;
    background: var(--color-surface);
    border: 1px solid var(--color-rule);
    border-radius: 0.5rem;
  }

  :is(.dock, .dock-sheet) .dock-panel [data-control-group] {
    margin-inline: -0.75rem;
    padding-block: 0.5rem;
    padding-inline: 0.5rem 0.75rem;
    border-inline-start: 3px solid transparent;
    border-radius: 0.4rem;
    transition:
      background-color 0.25s ease,
      border-color 0.25s ease;
  }

  :is(.dock, .dock-sheet) .dock-panel [data-control-group][aria-current="true"] {
    border-inline-start-color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 9%, transparent);
  }

  @media (prefers-reduced-motion: reduce) {
    :is(.dock, .dock-sheet) .dock-panel [data-control-group] {
      transition: none;
    }
  }

  .dock-heading {
    margin-block: 0 1.25rem;
    font-family: var(--font-ui);
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.35;
  }

  @media (width < 720px) {
    .dock-layout {
      padding-block-end: 5rem;
    }

    .dock {
      display: none;
    }

    .dock-fab {
      position: fixed;
      inset-block-end: 1rem;
      inset-inline-end: 1rem;
      z-index: 30;
      display: flex;
      align-items: center;
      gap: 0.6rem;
      min-block-size: 56px;
      min-inline-size: 56px;
      max-inline-size: calc(100vw - 2rem);
      padding-inline: 1rem 1.25rem;
      border: 0;
      border-radius: 28px;
      background: var(--color-accent);
      color: var(--color-on-accent);
      font: inherit;
      text-align: start;
      box-shadow: 0 6px 20px rgb(0 0 0 / 0.25);
      cursor: pointer;
    }

    .dock-fab .dock-icon {
      flex: none;
    }

    .dock-fab-text {
      display: grid;
      min-inline-size: 0;
      line-height: 1.25;
    }

    .dock-fab-label {
      font-weight: 600;
    }

    .dock-fab-summary {
      overflow: hidden;
      font-size: 0.8rem;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
  }

  .dock-sheet[open] {
    display: flex;
    flex-direction: column;
    inset-block: auto 0;
    inset-inline: 0;
    inline-size: 100%;
    max-inline-size: 100%;
    max-block-size: 85dvh;
    margin: 0;
    padding: 0;
    border: 0;
    border-start-start-radius: 1rem;
    border-start-end-radius: 1rem;
    background: var(--color-surface);
    color: var(--color-ink);
    box-shadow: 0 -8px 30px rgb(0 0 0 / 0.3);
  }

  .dock-sheet::backdrop {
    background: rgb(0 0 0 / 0.45);
  }

  .dock-sheet-bar {
    display: flex;
    justify-content: flex-end;
    padding-block: 0.25rem 0;
    padding-inline: 0.5rem;
    border-block-end: 1px solid var(--color-rule);
  }

  .dock-sheet-close {
    display: grid;
    place-items: center;
    inline-size: 44px;
    block-size: 44px;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--color-ink);
    cursor: pointer;
  }

  .dock-sheet-body {
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
    min-block-size: 0;
  }

  .dock-sheet .dock-panel {
    flex: 1 1 auto;
    min-block-size: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    border: 0;
    border-radius: 0;
  }

  @media (width >= 1024px) {
    .dock-layout {
      grid-template-columns: minmax(16rem, 19rem) minmax(0, 1fr);
      align-items: start;
      gap: 3rem;
    }

    .dock {
      position: sticky;
      inset-block-start: 1rem;
    }

    .dock-panel {
      max-block-size: calc(100dvh - 2rem);
      overflow-y: auto;
      overscroll-behavior: contain;
    }
  }

  @media (720px <= width < 1024px) {
    .dock {
      position: sticky;
      inset-block-start: 0;
      z-index: 20;
      margin-inline: calc(-1 * var(--main-gutter));
      padding-block: 0.5rem;
      padding-inline: var(--main-gutter);
      background: var(--color-bg);
      border-block-end: 1px solid var(--color-rule);
    }

    .dock-toggle {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      inline-size: 100%;
      min-block-size: 44px;
      padding-inline: 0.75rem;
      border: 1px solid var(--color-rule);
      border-radius: 0.5rem;
      background: var(--color-surface);
      color: var(--color-ink);
      font: inherit;
      text-align: start;
      cursor: pointer;
    }

    .dock-icon,
    .dock-chevron {
      flex: none;
    }

    .dock-toggle-label {
      flex: none;
      font-weight: 600;
    }

    .dock-summary {
      flex: 1 1 auto;
      min-inline-size: 0;
      overflow: hidden;
      color: var(--color-muted);
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .dock[data-open="true"] .dock-chevron {
      transform: rotate(180deg);
    }

    .dock[data-open="false"] .dock-panel {
      display: none;
    }

    .dock-panel {
      margin-block-start: 0.5rem;
      max-block-size: calc(100dvh - 5rem);
      overflow-y: auto;
      overscroll-behavior: contain;
    }

    .dock-panel .control-groups {
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    }
  }
</style>
