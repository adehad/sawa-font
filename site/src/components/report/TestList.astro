---
import { t } from "../../i18n/t";
import type { Locale } from "../../i18n/locales";
import { localizedPath } from "../../i18n/paths";
import { bundleFamilies, testShaping, worstStatus } from "../../report/summary";
import type { ReportBundle } from "../../report/types";

interface Props {
  locale: Locale;
  bundle: ReportBundle;
}

const { locale, bundle } = Astro.props;
const families = bundleFamilies(bundle);
const pagePath = localizedPath(import.meta.env.BASE_URL, locale, "report");
const numbers = new Intl.NumberFormat(locale, { useGrouping: false });
const [first] = bundle.tests;
---

<div class="tests" data-tests>
  <nav class="test-nav" aria-label={t(locale, "report.testList")}>
    <ol class="test-list">
      {
        bundle.tests.map((test) => {
          const status = worstStatus(bundle.shaping, test.id);
          return (
            <li>
              <a
                href={`${pagePath}?rt=${test.id}`}
                data-test-link={test.id}
                aria-current={test === first ? "true" : undefined}
              >
                <span class="test-id" dir="ltr">
                  {test.id}
                </span>
                {status !== "pass" && (
                  <span class="status" data-status={status}>
                    {t(locale, `report.status.${status}`)}
                  </span>
                )}
              </a>
            </li>
          );
        })
      }
    </ol>
  </nav>

  <div class="test-main">
    {
      bundle.tests.map((test) => (
        <article
          class="test-card"
          data-test-card={test.id}
          hidden={test !== first}
          aria-labelledby={`test-${test.id}-title`}
        >
          <h3 id={`test-${test.id}-title`} class="test-title">
            <span dir="ltr">{test.id}</span>
          </h3>
          <p class="test-purpose">{test.purpose[locale]}</p>
          <dl class="test-facts">
            <div>
              <dt>{t(locale, "report.text")}</dt>
              <dd class="test-text" dir="auto">
                {test.text}
              </dd>
            </div>
            <div>
              <dt>{t(locale, "report.codepoints")}</dt>
              <dd>
                <code class="codepoints" dir="ltr" data-codepoints>
                  {test.codepoints.join(" ")}
                </code>
              </dd>
            </div>
            <div>
              <dt>{t(locale, "report.features")}</dt>
              <dd>
                {test.features.length > 0 ? (
                  <code dir="ltr" data-features>
                    {test.features.join(", ")}
                  </code>
                ) : (
                  t(locale, "report.featuresNone")
                )}
              </dd>
            </div>
          </dl>
          <table class="test-shaping">
            <caption>{t(locale, "report.shapingByWeight")}</caption>
            <tbody>
              {families.map((family) => (
                <tr data-family={family}>
                  <th scope="row">{t(locale, `font.${family}.name`)}</th>
                  <td>
                    <ul class="weights">
                      {testShaping(bundle.shaping, family, test.id).map(({ weight, status }) => (
                        <li data-weight={weight} data-status={status}>
                          <span class="weight">{numbers.format(Number(weight))}</span>
                          <span class="status" data-status={status}>
                            {t(locale, `report.status.${status}`)}
                          </span>
                        </li>
                      ))}
                    </ul>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </article>
      ))
    }
    <slot />
  </div>
</div>

<script>
  import { mountTestList } from "./test-list";

  const root = document.querySelector<HTMLElement>("[data-tests]");
  if (root) {
    mountTestList(root);
  }
</script>

<style>
  .tests {
    display: grid;
    gap: 1.5rem;
  }

  @media (width >= 64rem) {
    .tests {
      grid-template-columns: minmax(14rem, 18rem) minmax(0, 1fr);
      align-items: start;
    }

    .test-nav {
      position: sticky;
      inset-block-start: 1rem;
      max-block-size: calc(100vh - 2rem);
      overflow-y: auto;
    }
  }

  .test-list {
    display: grid;
    gap: 0.15rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (width < 64rem) {
    .test-list {
      max-block-size: 14rem;
      overflow-y: auto;
      padding: 0.25rem;
      border: 1px solid var(--color-rule);
      border-radius: 0.5rem;
    }
  }

  .test-list a {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.25rem 0.5rem;
    min-block-size: 44px;
    padding-block: 0.25rem;
    padding-inline: 0.6rem;
    border-radius: 0.4rem;
    color: var(--color-ink);
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }

  .test-list a:hover {
    background: var(--color-surface);
  }

  .test-list a[aria-current="true"] {
    background: var(--color-accent);
    color: var(--color-on-accent);
  }

  .test-list .test-id {
    overflow-wrap: anywhere;
  }

  .test-main {
    display: grid;
    gap: 1rem;
    min-inline-size: 0;
  }

  .test-card {
    display: grid;
    gap: 0.75rem;
    min-inline-size: 0;
  }

  .test-card[hidden] {
    display: none;
  }

  .test-title {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 1.1rem;
    font-weight: 600;
    text-align: start;
    overflow-wrap: anywhere;
  }

  .test-purpose {
    margin: 0;
  }

  .test-facts {
    display: grid;
    gap: 0.5rem;
    margin: 0;
  }

  .test-facts div {
    display: grid;
    gap: 0.1rem 0.75rem;
    align-items: first baseline;
  }

  @media (width >= 40rem) {
    .test-facts div {
      grid-template-columns: 7rem minmax(0, 1fr);
    }
  }

  .test-facts dt {
    font-size: 0.85rem;
    color: var(--color-muted);
  }

  .test-facts dd {
    margin: 0;
    min-inline-size: 0;
  }

  .test-text {
    justify-self: start;
    font-family: var(--font-display);
    font-size: 1.25rem;
    overflow-wrap: anywhere;
  }

  .codepoints {
    display: inline-grid;
    font-size: 0.85rem;
    text-align: start;
    overflow-wrap: anywhere;
  }

  .test-shaping {
    border-collapse: collapse;
    font-size: 0.9rem;
  }

  .test-shaping caption {
    padding-block-end: 0.25rem;
    font-size: 0.85rem;
    color: var(--color-muted);
    text-align: start;
  }

  .test-shaping th,
  .test-shaping td {
    padding-block: 0.3rem;
    padding-inline: 0 1rem;
    border-block-end: 1px solid var(--color-rule);
    font-weight: 400;
    text-align: start;
    vertical-align: baseline;
  }

  .weights {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .weights li {
    display: flex;
    gap: 0.35rem;
    align-items: baseline;
  }

  .weight {
    font-variant-numeric: tabular-nums;
    color: var(--color-muted);
  }

  .status {
    font-size: 0.8rem;
    font-weight: 600;
    font-family: var(--font-ui);
  }

  .status[data-status="pass"] {
    color: var(--color-accent);
  }

  .status[data-status="fail"] {
    color: var(--color-fail);
  }

  .status[data-status="missing"] {
    color: var(--color-muted);
  }

  .test-list a[aria-current="true"] .status {
    color: inherit;
  }
</style>
