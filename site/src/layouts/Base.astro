---
import "../styles/global.css";
import LanguageSwitcher from "../components/LanguageSwitcher.astro";
import { t, type MessageKey } from "../i18n/t";
import { LOCALES, LOCALE_INFO, type Locale } from "../i18n/locales";
import { localizedPath, PAGE_NAMES, type PageName } from "../i18n/paths";
import { loadFontsData } from "../fonts/load";
import { fontFaceCss, fontStack, SAWA_FONT_IDS } from "../fonts/css";
import { isReportOnly } from "../report/mode";
import { markTokens } from "../marks/palettes";

interface Props {
  locale: Locale;
  page: PageName;
  title: string;
  /** Lets the page use the full content width instead of a reading column. */
  wide?: boolean;
}

const { locale, page, title, wide = false } = Astro.props;
const dir = LOCALE_INFO[locale].dir;
const base = import.meta.env.BASE_URL;
const reportOnly = isReportOnly();

// REPORT_ONLY builds only the report page; the nav and the brand link must
// not point at pages that were never built.
const homePage: PageName = reportOnly ? "report" : "specimen";
const visiblePages: readonly PageName[] = reportOnly ? (["report"] as const) : PAGE_NAMES;
const navEntries: { name: PageName; labelKey: MessageKey }[] = visiblePages.map((name) => ({
  name,
  labelKey: `nav.${name}` as MessageKey,
}));

const fontsData = loadFontsData();
const rootTokens = [
  `--font-ui: ${fontStack(fontsData, "sawa-sans")};`,
  `--font-display: ${fontStack(fontsData, "sawa-serif")};`,
  `--font-mono: ${fontStack(fontsData, "sawa-mono")};`,
  ...markTokens(),
]
  .map((line) => `  ${line}`)
  .join("\n");
const fontStyles = `${fontFaceCss(fontsData, base, reportOnly ? SAWA_FONT_IDS : undefined)}\n\n:root {\n${rootTokens}\n}`;

const uiFace = fontsData.fonts["sawa-sans"]?.faces.find((face) => face.style === "normal");
if (!uiFace) {
  throw new Error("fonts.json: font 'sawa-sans' has no normal face to preload");
}
const uiFaceHref = `${base}fonts/${uiFace.file}`;
---

<!doctype html>
<html lang={locale} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={uiFaceHref}
      crossorigin="anonymous"
    />
    <style is:global set:html={fontStyles}></style>
    {
      LOCALES.map((altLocale) => (
        <link
          rel="alternate"
          hreflang={altLocale}
          href={new URL(localizedPath(base, altLocale, page), Astro.site)}
        />
      ))
    }
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={localizedPath(base, locale, homePage)}>
        {t(locale, "site.name")}
      </a>
      <nav aria-label={t(locale, "nav.primary")}>
        <ul>
          {
            navEntries.map((entry) => (
              <li>
                <a
                  href={localizedPath(base, locale, entry.name)}
                  aria-current={entry.name === page ? "page" : undefined}
                >
                  {t(locale, entry.labelKey)}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <LanguageSwitcher currentLocale={locale} />
    </header>
    <main class:list={{ "main-wide": wide }}>
      <slot />
    </main>
    <footer class="site-footer">
      <p>{t(locale, "footer.license")}</p>
      <p><a href="https://github.com/adehad/sawa-font">{t(locale, "footer.source")}</a></p>
    </footer>
  </body>
</html>
