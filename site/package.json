{
  "name": "sawa-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "check:ts": "tsgo --noEmit -p tsconfig.json",
    "test": "vitest run",
    "lint:css": "stylelint \"src/**/*.{css,astro}\"",
    "lint": "oxlint --deny-warnings",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test:e2e": "playwright test",
    "test:e2e:report-only": "playwright test --config=playwright.report-only.config.ts"
  },
  "dependencies": {
    "astro": "^7.3.5",
    "intl-messageformat": "^12.1.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "eslint-plugin-playwright": "^2.12.0",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "postcss-html": "^2.0.0",
    "stylelint": "^17.15.0",
    "stylelint-use-logical": "^2.1.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2"
  },
  "packageManager": "bun@1.4.0"
}
